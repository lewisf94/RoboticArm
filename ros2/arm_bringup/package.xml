<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and demos for the RoboticArm bench rig: one command for bridge + robot_state_publisher + RViz, plus a wave demo that drives the arm through ROS 2.</description>
  <maintainer email="lewisfowler94@gmail.com">Lewis Fowler</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>arm_bridge</exec_depend>
  <exec_depend>arm_description</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
